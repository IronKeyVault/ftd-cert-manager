# Let's Encrypt Configuration
LETSENCRYPT_EMAIL=kasper@elsborg.eu
DOMAIN_NAME=vpn.ai-chatbot.dk

# Certificate paths
CERT_OUTPUT_DIR=/home/kasperadm/projects/ftd-cert-manager/certs
LOG_DIR=/home/kasperadm/projects/ftd-cert-manager/logs

# FMC Configuration
FMC_HOST=192.168.x.x
FMC_USERNAME=admin
FMC_PASSWORD=your_password_here
FMC_VERIFY_SSL=false
FMC_AUTO_DEPLOY=false  # Set to true to automatically deploy changes to FTD after certificate upload

# FTD Configuration
FTD_DEVICE_NAME=FTD-1010
FTD_CERT_NAME=VPN-Certificate

# Certbot configuration
CERTBOT_STAGING=false
CERTBOT_WEBROOT=/var/www/certbot
# CERTBOT_DNS_PROVIDER=manual  # Use manual DNS challenge if needed

# Notification settings (optional)
NOTIFICATION_EMAIL=kasper@elsborg.eu
